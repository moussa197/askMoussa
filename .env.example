# Modèle du fichier .env : copier ce fichier en ".env" puis remplir la clé.
# Ne JAMAIS mettre de vraie clé dans ce fichier (il est commité).

# Clé de l'API Anthropic (obligatoire).
ANTHROPIC_API_KEY=

# Modèle Claude utilisé et longueur max des réponses (en tokens).
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=400

# Longueur max d'une question (en caractères).
MAX_QUESTION_LENGTH=500

# Limites de requêtes : par IP (minute, jour) et plafond global par jour.
RATE_LIMIT_PAR_MINUTE=10
RATE_LIMIT_PAR_JOUR=30
PLAFOND_GLOBAL_JOUR=300

# Origines de développement autorisées en plus du portfolio, séparées par des virgules.
# Exemple : http://localhost:5500 — "*" est interdit.
CORS_ORIGINES_DEV=

# Position de l'IP réelle dans X-Forwarded-For (fixée au déploiement, voir PLAN.md §4.3).
XFF_POSITION=

# Méthode de recherche : "complet" (tous les documents) ou "bm25".
MODE_RECHERCHE=complet
